# AWS Bedrock configuration
# Option A: Use AWS_PROFILE (recommended if already configured via aws configure)
AWS_REGION=us-east-1
# AWS_PROFILE=your_profile_name   # only set if you need a non-default profile

# Option B: Use static credentials (uncomment if not using AWS_PROFILE)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Model to use for red team generation & analysis
# Claude 3 Sonnet (balanced) or Claude 3 Haiku (faster/cheaper)
BEDROCK_MODEL_ID=us.anthropic.claude-3-sonnet-20240229-v1:0

# Server port
PORT=3001

# Max prompts per OWASP category
MAX_PROMPTS_PER_CATEGORY=3

# Attack request timeout in ms
ATTACK_TIMEOUT_MS=30000
